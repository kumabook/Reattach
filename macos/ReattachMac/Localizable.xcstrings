    "Enable Apple Intelligence in System Settings to use on-device summaries.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Apple Intelligence in System Settings to use on-device summaries."
