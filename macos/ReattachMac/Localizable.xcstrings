        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで作業を要約する"
          }
        }
      }
    },
    "Uses Apple Intelligence on this Mac. Terminal output is not sent to a cloud service. Summaries may be inaccurate; use Space to check the original output. Recent output is shown when unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Intelligence on this Mac. Terminal output is not sent to a cloud service. Summaries may be inaccurate; use Space to check the original output. Recent output is shown when unavailable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのApple Intelligenceを使用します。ターミナルの出力をクラウドに送りません。要約には誤りが含まれる場合があります。Spaceで元の出力を確認できます。利用できない場合は直近の出力を表示します。"
          }
        }
      }
    },
    "Check availability": {
      "extractionState": "manual",
