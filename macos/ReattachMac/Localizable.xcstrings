{
  "sourceLanguage": "en",
  "strings": {
    "Customize the language, length, and focus of summaries. Applying changes regenerates cached summaries. Up to 1,200 characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize the language, length, and focus of summaries. Applying changes regenerates cached summaries. Up to 1,200 characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約の言語・長さ・注目する内容を指定できます。適用すると保存済みの要約を作り直します。最大1,200文字。"
          }
        }
      }
    },
    "Apply prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
