        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインは切り替わりましたが、ターミナルを前面に表示できませんでした。"
          }
        }
      }
    },
    "The panel is hidden. Press the same hotkey again to bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panel is hidden. Press the same hotkey again to bring it back."
