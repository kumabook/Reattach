    "The macOS blur material retains a slight tint. When Reduce Transparency is enabled, the background stays opaque.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The macOS blur material retains a slight tint. When Reduce Transparency is enabled, the background stays opaque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかしにはmacOSのすりガラス効果を使うため、薄い色味が残ります。「透明度を下げる」が有効な場合は不透明になります。"
          }
        }
      }
    },
    "The pane was selected, but the terminal could not be brought to the front.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pane was selected, but the terminal could not be brought to the front."
